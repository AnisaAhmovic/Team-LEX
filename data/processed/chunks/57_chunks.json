        "approval_date": "4th July 2025",
        "version": null,
        "text": "Section 5 - Policy\n(3)\nThis procedure forms part of the\nRecruitment Policy\nsuite which governs its application."
    },
    {
        "chunk_id": "57-6",
        "document_id": "57",
        "policy_title": "Recruitment Procedure - Dean",
