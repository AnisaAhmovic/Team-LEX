        "approval_authority": "Vice-Chancellor",
        "approval_date": "4th July 2025",
        "version": null,
        "text": "Section 3 - Scope\n(2)\nThis Procedure applies to Academic staff in a continuing or fixed-term position at the University."
    },
    {
        "chunk_id": "58-4",
