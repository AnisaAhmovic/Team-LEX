        "version": null,
        "text": "Section 2 - Purpose\n(1)\nThis Procedure establishes a process for the selection and appointment of the Head of Department position at La Trobe University."
    },
    {
        "chunk_id": "58-3",
        "document_id": "58",
        "policy_title": "Recruitment Procedure -  Head of Department",
