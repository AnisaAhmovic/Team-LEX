        "subtopic": "Costs",
        "paragraph_start": 9,
        "paragraph_end": 9,
        "source_url": "https://policies.latrobe.edu.au/document/view.php?id=98",
        "status_details_url": "https://policies.latrobe.edu.au/document/status-and-details.php?id=98",
