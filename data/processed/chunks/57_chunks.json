        "version": null,
        "text": "Section 2 - Purpose\n(1)\nThis Procedure establishes a process for the selection and appointment of the Dean position at La Trobe University."
    },
    {
        "chunk_id": "57-3",
        "document_id": "57",
        "policy_title": "Recruitment Procedure - Dean",
